# Hugging Face token, required only if using speaker diarization (pyannote.audio).
# Create one at https://huggingface.co/settings/tokens and accept the model terms at
# https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# Whisper model size for transcription (tiny, base, small, medium, large-v3).
# CPU-only: "small" is a reasonable accuracy/speed tradeoff; "base" is faster.
WHISPER_MODEL_SIZE=small

# Transcription language hint: "fr", "en", or leave empty for auto-detect.
WHISPER_LANGUAGE=fr
